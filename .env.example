# ─────────────── Supabase ───────────────
# Connection string del POOLER en modo transacción (puerto 6543).
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Es la que corresponde en Vercel: las funciones son efímeras y abren muchas
# conexiones cortas. La directa (5432) agota el límite del proyecto.
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Solo si más adelante usas Storage o Auth de Supabase:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

